{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rivallens/ai-startup-benchmark/schemas/company.schema.json",
  "title": "AI Startup Benchmark Company Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "summary",
    "product",
    "market",
    "business_model",
    "ai_profile",
    "framework_scores",
    "evidence",
    "last_reviewed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "legal_name": { "type": ["string", "null"] },
    "website": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "founded_year": {
      "type": ["integer", "null"],
      "minimum": 1900,
      "maximum": 2100
    },
    "hq": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "city": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "country": { "type": ["string", "null"] }
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "acquired", "shutdown", "stealth", "unknown"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_liner", "layer", "delivery", "description", "key_capabilities"],
      "properties": {
        "one_liner": { "type": "string" },
        "layer": {
          "type": "string",
          "enum": ["infrastructure", "model", "platform", "application", "services", "other"]
        },
        "delivery": {
          "type": "string",
          "enum": ["api", "saas", "open_source", "hardware", "marketplace", "hybrid", "other"]
        },
        "description": { "type": "string" },
        "key_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_type", "primary_persona", "category", "problem", "geo_focus"],
      "properties": {
        "customer_type": {
          "type": "string",
          "enum": ["consumer", "smb", "mid_market", "enterprise", "developer", "government", "mixed", "other"]
        },
        "primary_persona": { "type": "string" },
        "category": { "type": "string" },
        "problem": { "type": "string" },
        "geo_focus": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "business_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "pricing_visibility"],
      "properties": {
        "primary": {
          "type": "string",
          "enum": [
            "subscription",
            "usage",
            "seat",
            "license",
            "marketplace_take_rate",
            "services",
            "ads",
            "freemium",
            "open_core",
            "mixed",
            "unclear"
          ]
        },
        "notes": { "type": ["string", "null"] },
        "pricing_visibility": {
          "type": "string",
          "enum": ["public", "partial", "private", "unknown"]
        }
      }
    },
    "ai_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["centrality", "dependency"],
      "properties": {
        "centrality": {
          "type": "string",
          "enum": ["core", "embedded", "feature", "marketing", "unclear"]
        },
        "dependency": {
          "type": "string",
          "enum": [
            "owns_models",
            "fine_tunes",
            "api_wrapper",
            "orchestration",
            "data_network",
            "mixed",
            "unclear"
          ]
        },
        "model_strategy": { "type": ["string", "null"] },
        "data_advantage": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "traction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" },
              "as_of": { "type": ["string", "null"] },
              "evidence_ids": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_raised_usd": { "type": ["number", "null"], "minimum": 0 },
        "latest_round": { "type": ["string", "null"] },
        "latest_round_date": { "type": ["string", "null"] },
        "notable_investors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": ["string", "null"] },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "framework_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "market",
        "business_model",
        "technology",
        "growth",
        "competitive_position"
      ],
      "properties": {
        "product": { "$ref": "#/$defs/scoreDimension" },
        "market": { "$ref": "#/$defs/scoreDimension" },
        "business_model": { "$ref": "#/$defs/scoreDimension" },
        "technology": { "$ref": "#/$defs/scoreDimension" },
        "growth": { "$ref": "#/$defs/scoreDimension" },
        "competitive_position": { "$ref": "#/$defs/scoreDimension" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "founders": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "competitors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "scoreDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rationale", "evidence_ids"],
      "properties": {
        "value": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "rationale": { "type": "string" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": ["string", "null"],
          "enum": ["high", "medium", "low", null],
          "description": "Confidence in this dimension score given available evidence"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "title": { "type": ["string", "null"] },
        "publisher": { "type": ["string", "null"] },
        "published_at": { "type": ["string", "null"] },
        "accessed_at": { "type": ["string", "null"] },
        "snippet": { "type": ["string", "null"] },
        "type": {
          "type": ["string", "null"],
          "enum": [
            "company_website",
            "pricing_page",
            "docs",
            "github",
            "job_posting",
            "blog_post",
            "news_article",
            "interview",
            "regulatory_filing",
            "dataset_release",
            "other",
            null
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    }
  }
}
